{
  "name": "gerador-de-orcamento",
  "version": "1.2.2",
  "description": "Gerador de Orçamentos - VS Prestadora de Serviços",
  "main": "./out/main/index.js",
  "author": "VS Prestadora de Serviços",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icone": "node scripts/gerar-icone.mjs",
    "ia": "node scripts/preparar-ia.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "predist": "node scripts/preparar-ia.mjs",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "lucide-react": "^1.35.0",
    "node-sqlite3-wasm": "^0.8.59"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.1",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
