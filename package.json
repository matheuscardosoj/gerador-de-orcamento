{
  "name": "gerador-de-orcamento",
  "version": "1.5.0-rc.8",
  "description": "Documentos de serviços, cálculo de custos e gestão comercial",
  "main": "./out/main/index.js",
  "author": "Matheus",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prebuild": "node scripts/gerar-schema-nuvem.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "vitest run",
    "pretest": "node scripts/gerar-schema-nuvem.mjs",
    "schema:nuvem": "node scripts/gerar-schema-nuvem.mjs",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "icone": "node scripts/gerar-icone.mjs",
    "ia": "node scripts/preparar-ia.mjs",
    "pack": "npm run build && electron-builder --dir",
    "servico:configurar": "node scripts/preparar-servico-central.mjs",
    "backup:verificar": "node scripts/verificar-backup-local.mjs",
    "dist:central": "npm run servico:configurar && npm run dist",
    "predist": "node scripts/preparar-ia.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.3",
    "docx": "^9.7.1",
    "lucide-react": "^1.35.0",
    "node-sqlite3-wasm": "^0.8.59"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "playwright": "^1.64.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.1",
    "prettier": "3.9.6",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "@swc/core@1.16.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
